# red-art-studio 服务配置示例。复制为 .env 后按需修改：
#   cp .env.example .env
# 键名与 server/app/core/config.py 的 Settings 字段同名（大小写不敏感）。

# ---------- 推理后端 ----------
# 启用的 Provider：
#   openai_compat  — 任意 OpenAI images 兼容端点（需要真实端点）
#   comfyui        — 本地 ComfyUI（http://127.0.0.1:8188）
#   pollinations   — pollinations.ai 免 key 直连（临时冒烟通道，模型服务端路由）
# 切换后端只改此值，零代码改动（P1 总验收标准 #1）
PROVIDER=openai_compat

# ---------- Provider 端点与凭证 ----------
# openai_compat：任意 OpenAI 兼容端点根路径（如 https://api.openai.com/v1）
# comfyui：本地 ComfyUI HTTP API，默认 http://127.0.0.1:8188
# pollinations：忽略此值（内置 https://image.pollinations.ai），无需 key
PROVIDER_BASE_URL=https://api.openai.com/v1
# API 密钥（comfyui / pollinations 不需要，留空即可）
PROVIDER_API_KEY=
# 模型名（openai_compat 使用，如 gpt-image-1；comfyui / pollinations 忽略此值）
PROVIDER_MODEL=gpt-image-1
# 单次 Provider HTTP 请求超时（秒）
PROVIDER_TIMEOUT_SECONDS=120

# ---------- 存储 ----------
# 数据根目录（其下 jobs/ 与 artifacts/，见 ADR-002）
DATA_DIR=data
